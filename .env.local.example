# API
NEXT_PUBLIC_API_URL=http://localhost:3001

# Vercel Edge Config — mapeo dominio→tenant para el middleware (multi-dominio,
# un solo deploy). Sin esto, el middleware usa un fallback hardcodeado de dev
# (localhost:3000 → el-renuevo, ver src/middleware.ts).
# EDGE_CONFIG=

# Branding (client_name, brand_color, logo_url, favicon_url, whatsapp, email_from)
# ya NO vive en env vars — viene de tenant_config en impulso_ecommerce_api, resuelto
# por dominio en runtime. Ver src/lib/tenant-config.ts.

# Sync de tenant_domains → Edge Config (scripts/sync-edge-config.ts, no usado
# por la app en runtime, solo por el script de sincronización manual)
# SUPABASE_URL=
# SUPABASE_SERVICE_KEY=
# VERCEL_API_TOKEN=
# EDGE_CONFIG_ID=
